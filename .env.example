# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.104,192.168.0.117

# Database — set DB_ENGINE=sqlite for a local file DB, or fill in Postgres
# credentials below. These used to be hardcoded in core/settings.py; they now
# live here so they never end up in version control.
DB_ENGINE=postgresql
DB_NAME=neondb
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-host.neon.tech
DB_PORT=5432
DB_SSLMODE=require

# Uploads — largest blog cover image an author may upload, in bytes (5MB)
BLOG_COVER_MAX_BYTES=5242880

# Frontend origin(s) — comma separated
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.0.104:3000,http://192.168.0.117:3000

# Used to build links inside emails
EMAIL_PAGE_DOMAIN=https://mydomain.com/

# Gmail SMTP (use a Gmail "App Password", not your normal password)
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be ON)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword
DEFAULT_FROM_EMAIL=youraddress@gmail.com

# OTP
OTP_EXPIRY_MINUTES=10

# Auth redirects (not used by the current JWT flow — see settings.py note)
LOGIN_URL=otp_auth:login
LOGIN_REDIRECT_URL=otp_auth:success
